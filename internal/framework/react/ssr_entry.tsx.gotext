"use strict"

import { renderHtml } from "runtime:ssr_runtime.tsx"

{{- range $i, $page := $.Pages }}
import Page{{ $i }} from {{ printf "%q" (print "./" $page.Entry) }}
{{- if $page.Error }}
import Error{{ $i }} from {{ printf "%q" (print "./" $page.Error) }}
{{- end }}
{{- end }}

{{- range $i, $view := $.Views }}
import View{{ $i }} from {{ printf "%q" (print "./" $view) }}
{{- end }}

export const views = {
  {{- range $i, $page := $.Pages }}
  {{ printf "%q" $page.Entry }}: Page{{ $i }},
  {{- end }}
  {{- range $i, $view := $.Views }}
  {{ printf "%q" $view }}: View{{ $i }},
  {{- end }}
}

// Error views by the page they're nearest to
const errors = {
  {{- range $i, $page := $.Pages }}
  {{- if $page.Error }}
  {{ printf "%q" $page.Entry }}: Error{{ $i }},
  {{- end }}
  {{- end }}
}

export function render(names: string[], props: string[]) {
  return renderHtml(views, errors, names, props)
}
