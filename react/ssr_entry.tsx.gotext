"use strict"

import { Page, renderHtml } from "runtime:ssr_runtime.tsx"
import EntryView from "./{{ $.Page.EntryPath }}"

{{- if $.Page.LayoutPath }}
import LayoutView from "./{{ $.Page.LayoutPath }}"
{{- end }}

{{- if $.Page.ErrorPath }}
import ErrorView from "./{{ $.Page.ErrorPath }}"
{{- end }}

const page: Page = {
  EntryView,
  clientRoute: "/{{ $.Page.EntryPath }}.js",
  {{- if $.LiveRoute }}
  liveRoute: "{{ $.LiveRoute }}",
  {{- end }}
  {{- if $.Page.LayoutPath }}
  LayoutView,
  {{- end }}
  {{- if $.Page.ErrorPath }}
  ErrorView,
  {{- end }}
}

export function render(props) {
  return renderHtml(page, props)
}
