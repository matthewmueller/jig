"use strict"

import { Page, renderHtml } from "runtime:ssr_runtime.tsx"
import EntryView from "./{{ $.Page.Entry }}"

{{- if $.Page.Layout }}
import LayoutView from "./{{ $.Page.Layout }}"
{{- end }}

{{- if $.Page.Error }}
import ErrorView from "./{{ $.Page.Error }}"
{{- end }}

const page: Page = {
  EntryView,
  clientRoute: "/{{ $.Page.Entry }}.js",
  {{- if $.Page.Layout }}
  LayoutView,
  {{- end }}
  {{- if $.Page.Error }}
  ErrorView,
  {{- end }}
}

export function render(props) {
  return renderHtml(page, props)
}
