"use strict"

import { renderToString } from "react-dom/server"
import Entry from "./{{ $.EntryPath }}"

export function render(path, props) {
	let html = renderToString(<Entry {...props} />)
  // Add a doctype if an html tag is present
  html = html.replace("<html", "<!doctype html><html")
	{{- if $.LiveRoute }}
	html = html.replace('</body>', `<script defer async src="{{ $.LiveRoute }}" type="module"></script></body>`)
	{{- end }}
	{{- if $.Hydrate }}
	html = html.replace('</body>', `<script type="application/json" id="react-props">${JSON.stringify(props)}</script><script defer async src="/{{ $.EntryPath }}.js"></script></body>`)
	{{- end }}
	return html
}
